# ------------------------------------------------------------------
# HackPack configuration. Copy to .env and adjust. Never commit .env.
# ------------------------------------------------------------------

# --- AI provider ----------------------------------------------------
# Local-first default: Ollama on this machine. No hosted API key needed.
# Smaller-model options for 8 GB RAM laptops: llama3.2:3b, qwen2.5:3b, gemma2:2b.
LLM_MODEL=ollama/llama3.1
LLM_API_BASE=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
# Retries after the first structured-output attempt (0-2).
LLM_MAX_RETRIES=2
# Deterministic template pitch when the model is unavailable/invalid (default on).
LLM_FALLBACK_ENABLED=true

# Optional hosted provider example (requires the matching provider API key):
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=replace-me
# LLM_API_BASE=

# --- GitHub ---------------------------------------------------------
# Optional. Anonymous access works for public repos with lower rate limits.
GITHUB_TOKEN=

# --- Repository analysis limits -------------------------------------
MAX_FILE_SIZE_BYTES=100000
MAX_FILES_TO_ANALYZE=50
MAX_README_LENGTH=30000
MAX_SOURCE_EXCERPTS=12
MAX_TOTAL_EXCERPT_CHARS=55000
MAX_TEST_EXCERPTS=4
ANALYSIS_TIME_BUDGET_SECONDS=60

# --- API ------------------------------------------------------------
# Exact origins only (no wildcards). For the deployed Lovable frontend, add
# its exact production origin here, e.g. https://your-app.lovable.app
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501
REQUEST_TIMEOUT_SECONDS=180
MAX_REQUEST_BODY_BYTES=2000000

# --- Output ---------------------------------------------------------
OUTPUT_DIR=generated
# Keep false in production; writes a debug copy of each ZIP under OUTPUT_DIR.
SAVE_GENERATED_ZIPS=false

DEFAULT_PITCH_DURATION_MINUTES=3
