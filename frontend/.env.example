# Base URL of your existing FastAPI service. Leave empty to show a disconnected state.
VITE_API_BASE_URL=http://localhost:8000

# Endpoint paths are intentionally configurable; align them with the existing backend.
VITE_API_HEALTH_PATH=/api/health
VITE_API_ANALYZE_PATH=/api/analyze
VITE_API_PITCH_PATH=/api/pitch
VITE_API_GENERATE_PATH=/api/generate
VITE_API_TIMEOUT_MS=90000

# URL of the public HackPack source repository (replace with the actual repository URL).
VITE_OPEN_SOURCE_REPO_URL=
